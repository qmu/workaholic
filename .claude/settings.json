{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "WORKAHOLIC_INBOUND_SLACK_CHANNEL": "dev-workaholic"
  },
  "permissions": {
    "allow": [
      "Bash(gh api:*)",
      "Bash(git rebase:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(sh:*)"
    ]
  },
  "enabledPlugins": {
    "workaholic@workaholic": true
  },
  "extraKnownMarketplaces": {
    "workaholic": {
      "source": {
        "source": "github",
        "repo": "qmu/workaholic"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
